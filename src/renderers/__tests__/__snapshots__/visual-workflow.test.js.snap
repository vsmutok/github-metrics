exports[`Visual Regression: Structural Snapshots Snapshots theme: pasteldream 1`] = `
"
<svg
  xmlns="http://www.w3.org/2000/svg"
  xmlns:xlink="http://www.w3.org/1999/xlink"
  width="960"
  height="600"
  viewBox="0 0 960 600"
  role="img"
  aria-labelledby="dashboard-title dashboard-desc"
  xml:lang="en"
  lang="en"
>
<title id="dashboard-title">GitHub Dashboard</title>
<desc id="dashboard-desc">GitHub profile statistics</desc>


  <defs aria-hidden="true">
    <!-- ambient card gradient -->
    <linearGradient id="mainGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffb3c1" stop-opacity="0.07"/>
      <stop offset="100%" stop-color="#caffbf" stop-opacity="0.07"/>
    </linearGradient>

    <!-- accent gradient (solid for flat themes) -->
    <linearGradient id="accentGradient" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#ffb3c1"/>
      <stop offset="100%" stop-color="#caffbf"/>
    </linearGradient>

    <!-- vertical fill used by bars and medallions -->
    <linearGradient id="barGradient" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ffb3c1"/>
      <stop offset="100%" stop-color="#caffbf" stop-opacity="0.4"/>
    </linearGradient>

    <!-- soft top glow behind the header -->
    <radialGradient id="headerGlow" cx="50%" cy="0%" r="75%">
      <stop offset="0%" stop-color="#ffb3c1" stop-opacity="0.16"/>
      <stop offset="100%" stop-color="#ffb3c1" stop-opacity="0"/>
    </radialGradient>

    <filter id="softGlow" x="-100%" y="-100%" width="300%" height="300%">
      <feGaussianBlur stdDeviation="4" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>

  <g aria-hidden="true">
  <!-- base background -->
  <rect x="0" y="0" width="960" height="600" rx="16" ry="16" fill="#1f1d2b"/>

  <!-- ambient wash -->
  <rect x="0" y="0" width="960" height="600" rx="16" ry="16" fill="url(#mainGradient)"/>

  <!-- soft header glow -->
  <rect x="0" y="0" width="960" height="190" rx="16" ry="16" fill="url(#headerGlow)"/>

  <!-- hairline border -->
  <rect x="0.5" y="0.5" width="959" height="599" rx="16" ry="16" fill="none" stroke="#4c4566" stroke-width="1" opacity="0.9"/>

