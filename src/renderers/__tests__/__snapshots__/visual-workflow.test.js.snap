exports[`Visual Regression: Structural Snapshots Renderer permutations snapshots no CP platform 1`] = `
"
<svg
  xmlns="http://www.w3.org/2000/svg"
  xmlns:xlink="http://www.w3.org/1999/xlink"
  width="960"
  height="700"
  viewBox="0 0 960 700"
  role="img"
  aria-labelledby="dashboard-title dashboard-desc"
  xml:lang="en"
  lang="en"
>
<title id="dashboard-title">GitHub Dashboard</title>
<desc id="dashboard-desc">GitHub profile statistics</desc>


  <defs aria-hidden="true">
    <!-- ambient card gradient -->
    <linearGradient id="mainGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#7c3aed" stop-opacity="0.07"/>
      <stop offset="100%" stop-color="#06b6d4" stop-opacity="0.07"/>
    </linearGradient>

    <!-- accent gradient (solid for flat themes) -->
    <linearGradient id="accentGradient" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#7c3aed"/>
      <stop offset="100%" stop-color="#06b6d4"/>
    </linearGradient>

    <!-- vertical fill used by bars and medallions -->
    <linearGradient id="barGradient" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#7c3aed"/>
      <stop offset="100%" stop-color="#06b6d4" stop-opacity="0.4"/>
    </linearGradient>

    <!-- soft top glow behind the header -->
    <radialGradient id="headerGlow" cx="50%" cy="0%" r="75%">
      <stop offset="0%" stop-color="#7c3aed" stop-opacity="0.16"/>
      <stop offset="100%" stop-color="#7c3aed" stop-opacity="0"/>
    </radialGradient>

    <filter id="softGlow" x="-100%" y="-100%" width="300%" height="300%">
      <feGaussianBlur stdDeviation="4" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>

  <g aria-hidden="true">
  <!-- base background -->
  <rect x="0" y="0" width="960" height="700" rx="16" ry="16" fill="#0a0a0f"/>

  <!-- ambient wash -->
  <rect x="0" y="0" width="960" height="700" rx="16" ry="16" fill="url(#mainGradient)"/>

  <!-- soft header glow -->
  <rect x="0" y="0" width="960" height="190" rx="16" ry="16" fill="url(#headerGlow)"/>

  <!-- hairline border -->
  <rect x="0.5" y="0.5" width="959" height="699" rx="16" ry="16" fill="none" stroke="#1e1e2e" stroke-width="1" opacity="0.9"/>

  <!-- watermark -->
  
</g>

  <g role="group" aria-labelledby="card-test-card-50-50-title">
    <!-- card background -->
    <rect x="50" y="50" width="200" height="100" rx="12" ry="12" fill="#12121a"/>
    <!-- ambient wash -->
    <rect x="50" y="50" width="200" height="100" rx="12" ry="12" fill="url(#mainGradient)" opacity="0.5"/>
    <!-- border -->
    <rect x="50.5" y="50.5" width="199" height="99" rx="12" ry="12" fill="none" stroke="#1e1e2e" stroke-width="1" opacity="0.5"/>
    <!-- title underline accent -->
    <rect x="68" y="69" width="3" height="12" rx="6" fill="url(#accentGradient)"/>
    <text id="card-test-card-50-50-title" x="78" y="78" font-family="'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" font-size="11.5" font-weight="700" fill="#94a3b8" letter-spacing="1.1">TEST CARD</text>

    <!-- domain card decorations -->
    
  </g>

  <g transform="translate(28, 100)">
    
    <defs>
      <linearGradient id="lineGradient-chart-28-100" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#7c3aed"/>
        <stop offset="50%" stop-color="#6366f1"/>
        <stop offset="100%" stop-color="#06b6d4"/>
      </linearGradient>
      <linearGradient id="areaGradient-chart-28-100" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#7c3aed" stop-opacity="0.4"/>
        <stop offset="50%" stop-color="#06b6d4" stop-opacity="0.2"/>
        <stop offset="100%" stop-color="#7c3aed" stop-opacity="0"/>
      </linearGradient>
      <filter id="lineGlow-chart-28-100" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="3" result="blur"/>
        <feMerge>
          <feMergeNode in="blur"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>
    </defs>
  
    <line x1="12" y1="12" x2="388" y2="12" stroke="#1e1e2e" stroke-width="1" opacity="0.3" stroke-dasharray="4 4"/>
<line x1="12" y1="56" x2="388" y2="56" stroke="#1e1e2e" stroke-width="1" opacity="0.3" stroke-dasharray="4 4"/>
<line x1="12" y1="100" x2="388" y2="100" stroke="#1e1e2e" stroke-width="1" opacity="0.3" stroke-dasharray="4 4"/>
<line x1="12" y1="144" x2="388" y2="144" stroke="#1e1e2e" stroke-width="1" opacity="0.3" stroke-dasharray="4 4"/>
<line x1="12" y1="188" x2="388" y2="188" stroke="#1e1e2e" stroke-width="1" opacity="0.3" stroke-dasharray="4 4"/>
    <path d="M 12 188 C 30.799999999999997 168.2, 37.06666666666666 128.6, 74.66666666666666 122 C 112.26666666666665 115.4, 99.73333333333332 192.4, 137.33333333333331 166 C 174.9333333333333 139.6, 162.4 53.8, 200 34 C 237.6 14.2, 225.0666666666666 106.6, 262.66666666666663 100 C 300.26666666666665 93.4, 287.73333333333335 25.2, 325.33333333333337 12 C 362.9333333333334 -1.1999999999999993, 369.2 42.8, 388 56 L 388 188 L 12 188 Z" fill="url(#areaGradient-chart-28-100)"/>
