exports[`Visual Regression: Structural Snapshots Renderer permutations snapshots graceful fallback rendering 1`] = `
"
<svg
  xmlns="http://www.w3.org/2000/svg"
  xmlns:xlink="http://www.w3.org/1999/xlink"
  width="960"
  height="240"
  viewBox="0 0 960 240"
  role="img"
  aria-labelledby="dashboard-title dashboard-desc"
  xml:lang="en"
  lang="en"
>
<title id="dashboard-title">GitHub Dashboard</title>
<desc id="dashboard-desc">GitHub profile statistics</desc>


  <defs aria-hidden="true">
    <!-- ambient card gradient -->
    <linearGradient id="mainGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#7c3aed" stop-opacity="0.07"/>
      <stop offset="100%" stop-color="#06b6d4" stop-opacity="0.07"/>
    </linearGradient>

    <!-- accent gradient (solid for flat themes) -->
    <linearGradient id="accentGradient" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#7c3aed"/>
      <stop offset="100%" stop-color="#06b6d4"/>
    </linearGradient>

    <!-- vertical fill used by bars and medallions -->
    <linearGradient id="barGradient" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#7c3aed"/>
      <stop offset="100%" stop-color="#06b6d4" stop-opacity="0.4"/>
    </linearGradient>

    <!-- soft top glow behind the header -->
    <radialGradient id="headerGlow" cx="50%" cy="0%" r="75%">
      <stop offset="0%" stop-color="#7c3aed" stop-opacity="0.16"/>
      <stop offset="100%" stop-color="#7c3aed" stop-opacity="0"/>
    </radialGradient>

    <filter id="softGlow" x="-100%" y="-100%" width="300%" height="300%">
      <feGaussianBlur stdDeviation="4" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>

  <g aria-hidden="true">
  <!-- base background -->
  <rect x="0" y="0" width="960" height="240" rx="16" ry="16" fill="#0a0a0f"/>

  <!-- ambient wash -->
  <rect x="0" y="0" width="960" height="240" rx="16" ry="16" fill="url(#mainGradient)"/>

  <!-- soft header glow -->
  <rect x="0" y="0" width="960" height="190" rx="16" ry="16" fill="url(#headerGlow)"/>

  <!-- hairline border -->
  <rect x="0.5" y="0.5" width="959" height="239" rx="16" ry="16" fill="none" stroke="#1e1e2e" stroke-width="1" opacity="0.9"/>

  <!-- watermark -->
  
</g>
<text x="28" y="36" font-family="'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" font-size="17" font-weight="700" fill="#ffffff">github-metrics</text>
<text x="932" y="36" font-family="'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" font-size="11" fill="#64748b" text-anchor="end">dashboard</text>

  <g role="group" aria-labelledby="card-status-28-50-title">
    <!-- card background -->
    <rect x="28" y="50" width="904" height="168" rx="12" ry="12" fill="#12121a"/>
    <!-- ambient wash -->
    <rect x="28" y="50" width="904" height="168" rx="12" ry="12" fill="url(#mainGradient)" opacity="0.5"/>
    <!-- border -->
    <rect x="28.5" y="50.5" width="903" height="167" rx="12" ry="12" fill="none" stroke="#1e1e2e" stroke-width="1" opacity="0.5"/>
    <!-- title underline accent -->
    <rect x="46" y="69" width="3" height="12" rx="6" fill="url(#accentGradient)"/>
    <text id="card-status-28-50-title" x="56" y="78" font-family="'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" font-size="11.5" font-weight="700" fill="#94a3b8" letter-spacing="1.1">STATUS</text>

    <!-- domain card decorations -->
    
  </g>
<circle cx="480" cy="108" r="24" fill="#ef4444" opacity="0.12"/>
<text x="480" y="116" font-family="Arial, sans-serif" font-size="26" font-weight="700" fill="#ef4444" text-anchor="middle">!</text>
<text x="480" y="148" font-family="'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" font-size="19" font-weight="700" fill="#ef4444" text-anchor="middle">Unable to Load Profile</text>
<text x="480" y="168" font-family="'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" font-size="12" fill="#7c3aed" text-anchor="middle">@fallback-user</text>
<text x="480" y="186" font-family="'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" font-size="12" fill="#94a3b8" text-anchor="middle">Something went wrong while fetching GitHub data.</text>
<text x="480" y="204" font-family="'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" font-size="11" fill="#64748b" text-anchor="middle">Verify your username and try again.</text>
<text x="480" y="232" font-family="monospace" font-size="10" fill="#64748b" text-anchor="middle" opacity="0.7">Renderer fallback path</text>
</svg>"
`;

