        <path d="M 232 58 L 242 58 L 242 68" fill="none" stroke="#ff9c00" stroke-width="1.5" opacity="0.8"/>
        <path d="M 58 132 L 58 142 L 68 142" fill="none" stroke="#ff9c00" stroke-width="1.5" opacity="0.8"/>
        <path d="M 232 142 L 242 142 L 242 132" fill="none" stroke="#ff9c00" stroke-width="1.5" opacity="0.8"/>
      
