      <stop offset="0%" stop-color="#a6e22e"/>
      <stop offset="100%" stop-color="#ae81ff"/>
    </linearGradient>

    <!-- vertical fill used by bars and medallions -->
    <linearGradient id="barGradient" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#a6e22e"/>
      <stop offset="100%" stop-color="#ae81ff" stop-opacity="0.4"/>
