    <text id="card-test-card-50-50-title" x="78" y="78" font-family="'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" font-size="11.5" font-weight="700" fill="#a0a1a5" letter-spacing="1.1">TEST CARD</text>

