    <text id="card-test-card-50-50-title" x="78" y="78" font-family="'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" font-size="11.5" font-weight="700" fill="#adbac7" letter-spacing="1.1">TEST CARD</text>

    <!-- domain card decorations -->
    
  </g>

  <g transform="translate(28, 100)">
    
    <defs>
      <linearGradient id="lineGradient-chart-28-100" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#539bf5"/>
