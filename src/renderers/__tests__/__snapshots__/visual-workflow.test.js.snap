        <stop offset="50%" stop-color="#b083f0" stop-opacity="0.2"/>
        <stop offset="100%" stop-color="#539bf5" stop-opacity="0"/>
      </linearGradient>
      <filter id="lineGlow-chart-28-100" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="3" result="blur"/>
        <feMerge>
          <feMergeNode in="blur"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>
    </defs>
  
