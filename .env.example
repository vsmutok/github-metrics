# =============================================================================
# github-metrics — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- GitHub API --------------------------------------------------------------
# GitHub Personal Access Token (required for higher API rate limits & streak stats)
# Create one at: https://github.com/settings/tokens
# No special scopes needed — public access only
GITHUB_TOKEN=ghp_your_token_here

# --- Server ------------------------------------------------------------------
# Port the server listens on (optional — defaults to 3000)
PORT=3000

# Node environment (optional — defaults to development)
# Accepted values: development, production
NODE_ENV=development

# Fallback username when the request omits ?username (optional — defaults to vsmutok)
DEFAULT_USERNAME=vsmutok

# --- Cache -------------------------------------------------------------------
# In-memory cache maximum entries (optional — defaults to 1000)
# Production TTL: 30 minutes | Development TTL: 5 minutes
CACHE_MAX_SIZE=1000

# --- Analytics (MongoDB) -----------------------------------------------------
# MongoDB connection URI (optional — analytics logging)
# If not set, analytics are silently disabled
MONGODB_URI=mongodb://localhost:27017/github-metrics

# MongoDB database name (optional — defaults to the database name in MONGODB_URI)
# MONGODB_DB=github-metrics

# Set to "true" to disable analytics logging even when MONGODB_URI is set (optional)
# ANALYTICS_DISABLED=true

# --- Admin -------------------------------------------------------------------
# API key for protected admin endpoints (optional — /api/cache/stats requires this)
# If not set, cache stats are publicly accessible
# ADMIN_API_KEY=ur_admin_key_here

# --- Cache warm-up cron ------------------------------------------------------
# Secret that Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`.
# Set the same value in the Vercel project env vars. If unset, /api/cron/* is open.
# CRON_SECRET=ur_cron_secret_here

# Comma-separated GitHub pages scanned for camo image URLs (rendered HTML).
# Defaults to https://github.com/<DEFAULT_USERNAME>
# CRON_WARM_PAGES=https://github.com/vsmutok

# Comma-separated hosts that camo URLs must point at to be warmed.
# Defaults to ghmetric.vercel.app
# CRON_WARM_HOSTS=ghmetric.vercel.app